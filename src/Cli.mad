import type { Flag } from "ensign/Flags"

import type { ClownState } from "@/State"

import { Left, Right } from "Either"
import Either from "Either"
import IO from "IO"
import List from "List"
import { Just, isJust } from "Maybe"
import Term from "Terminal"
import Wish from "Wish"

import Ensign from "ensign/Declared"
import Declared from "ensign/Declared/Flags"
import EPrint from "ensign/Declared/Print"
import EFlags from "ensign/Flags"

import ClownCar from "@/ClownCar"
import _File from "@/File"
import MadlibJson from "@/MadlibJson"
import { SadClown } from "@/State"
import State from "@/State"



conditionalColor = (fn, k, x) => k ? fn(x) : x
CLOWNCAR = "clown-car 🤡🚗 (0.0.1)"
export FLAGS = [
  Declared.flagBoolean("help", ["h"], "🧐 These helpful explanations you're reading"),
  Declared.flagBoolean("color", ["K"], "🎨 Use color? (default: true)"),
  Declared.flagString(
    "madlib-json",
    ["madlib", "M"],
    "😈 Where is the madlib.json file? (default: ./madlib.json)",
  ),
  Declared.flagString("input", ["i"], "🥺 Set the input for the clowncar. Required."),
  Declared.flagString(
    "output",
    ["o"],
    "✨ Set the output for the clowncar. Inferred from `--input` if not provided.",
  ),
]
createColor = (x) => (
  {
    yellow: conditionalColor(IO.yellow, x),
    red: conditionalColor(IO.red, x),
    cyan: conditionalColor(Term.text.cyan, x),
    bold: conditionalColor(Term.text.bold, x),
    magenta: conditionalColor(Term.text.magenta, x),
  }
)
backticks = "```"
renderHelpDeets = (bool, useColor, flags) => {
  C = createColor(useColor)
  fn = (useColor ? EPrint.printLegendWithColor : EPrint.printLegend)
  return CLOWNCAR
    ++ "\n\n"
    ++ "Tooling to autogenerate PartyBus logging files"
    ++ (
      bool
        ? `, from a simple representative format:${"\n\n" ++ backticks}
// comments are allowed, but only single line
// this is the base tag value, equivalent to PartyBus.tag("bicycle")${
          "\n" ++ C.bold(C.red("bicycle"))
        }
- ${
          C.yellow("body")
        } // this is an implicit nested tag (so: PartyBus.tagWithScope("bicycle", ["body"]))
- ${C.yellow("body")}:${
          C.cyan("fork")
        } // this is a nested implicit tag (so: PartyBus.tagWithScope("bicycle", ["body", "fork"]) and this becomes bodyFork)
- ${C.bold("config")} = ${C.yellow("xyz")} // config = PartyBus.tagWithScope("bicycle", ["xyz"])
- ${C.bold("ref")} = ${C.yellow("config")}:${
          C.cyan("seat")
        } // ref = PartyBus.tagWithScope("bicycle", ["config", "seat"])
- ${C.yellow("handlebar")}
- ${C.yellow("handlebar")}:${C.cyan("brake")}
- ${C.yellow("seat")}
- ${C.yellow("wheel")}
- ${C.yellow("wheel")}:${C.cyan("spoke")}
- ${C.yellow("wheel")}:${C.cyan("tire")}
- ${C.yellow("wheel")}:${C.cyan("shifter")}
- ${C.yellow("wheel")}:${C.cyan("brake")}
- ${C.yellow("wheel")}:${C.cyan("brake")}:${C.magenta("front")}
- ${C.yellow("wheel")}:${C.cyan("brake")}:${C.magenta("rear")}`
          ++ "\n"
          ++ backticks
          ++ "\n\n"
        : "\n\n"
    )
    ++ fn(flags)
    ++ "\n\n"
}
export renderHelp = renderHelpDeets(false)
export renderHelpWithDetail = renderHelpDeets(true)
processFlagState :: ClownState
  -> (ClownState -> Flag -> #[Boolean, ClownState])
  -> List Flag
  -> ClownState
processFlagState = (state, process, flags) => {
  walker = (done, aggState, toProcess) => if (done) {
    aggState
  } else {
    where(toProcess) {
      [] =>
        aggState

      [a, ...z] =>
        where(process(aggState, a)) {
          #[stop, upState] =>
            walker(stop, upState, z)
        }
    }
  }
  return walker(false, state, flags)
}
parseArgs = pipe(
  EFlags.parseFlags,
  Ensign.validate(FLAGS),
  Either.mapLeft(EPrint.printIssues),
)
captureTheFlag :: ClownState -> Flag -> #[Boolean, ClownState]
export captureTheFlag = (state, flag) => where(flag) {
  EFlags.Flag(k, v) =>
    if (k == "madlib-json") {
      #[true, { ...state, madlibJsonPath: v }]
    } else if (k == "input") {
      #[false, { ...state, input: Just(v) }]
    } else if (k == "output") {
      #[false, { ...state, output: Just(v) }]
    } else {
      #[false, state]
    }

  EFlags.FlagToggle(k, v) =>
    if (k == "help") {
      #[true, { ...state, showHelp: true }]
    } else if (k == "color") {
      #[false, { ...state, useColor: v }]
    } else {
      #[false, state]
    }

  EFlags.InvalidFlag =>
    #[true, { ...state, failure: Just("Passed invalid flags") }]
}
writeOut = (useColor, jsonPath, src, outPath) => pipe(
  MadlibJson.readAndParse,
  Wish.mapRej(SadClown(false, useColor)),
  chain(
    (json) => pipe(
      ClownCar.applySpiritGumWithRules(json),
      outPath,
      Wish.mapRej(SadClown(false, useColor)),
    )(src),
  ),
)(jsonPath)
FAIL_CASE = "<show help, don't show this value>"
export fillfull = Wish.fulfill(
  where {
    SadClown(showHelp, useColor, bad) =>
      if (bad == FAIL_CASE) {
        IO.put(renderHelpDeets(showHelp, useColor, FLAGS))
      } else do {
        IO.putLine(bad)
        IO.put(renderHelpDeets(false, useColor, FLAGS))
      }
  },
  (good) => {
    IO.put(good)
  },
)
export consumeFlags = pipe(
  List.drop(1),
  parseArgs,
  map(processFlagState(State.INITIAL_STATE, captureTheFlag)),
)
// check for explicit failure as we go, if so
// swap to a bad wish
export applyClownCar = where {
  Right({ failure, input, madlibJsonPath, useColor, output, showHelp }) =>
    where(#[input, output]) {
      #[Just(src), Just(out)] =>
        if (showHelp || isJust(failure)) {
          Wish.bad(SadClown(showHelp, useColor, (failure ?? FAIL_CASE)))
        } else {
          writeOut(useColor, madlibJsonPath, src, _File.write(out))
        }

      #[Just(src), _] =>
        if (showHelp || isJust(failure)) {
          Wish.bad(SadClown(showHelp, useColor, (failure ?? FAIL_CASE)))
        } else {
          writeOut(useColor, madlibJsonPath, src, _File.writeDynamicName(src))
        }

      _ =>
        Wish.bad(SadClown(true, useColor, showHelp ? FAIL_CASE : "--input is required"))
    }

  Left(why) =>
    Wish.bad(SadClown(false, true, why))
}
export processArgs = pipe(
  consumeFlags,
  applyClownCar,
)
