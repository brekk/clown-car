import type { Flag } from "ensign/Flags"

import type { ClownState } from "@/State"

import { Left, Right } from "Either"
import Either from "Either"
import IO from "IO"
import List from "List"
import { Just } from "Maybe"
import Term from "Terminal"
import Wish from "Wish"

import Ensign from "ensign/Declared"
import Declared from "ensign/Declared/Flags"
import EPrint from "ensign/Declared/Print"
import EFlags from "ensign/Flags"

import ClownCar from "@/ClownCar"
import _File from "@/File"
import MadlibJson from "@/MadlibJson"
import State from "@/State"



CLOWNCAR = "🤡🚗 clown-car"
export FLAGS = [
  Declared.flagBoolean("help", ["h"], "🧐 These helpful explanations you're reading"),
  Declared.flagBoolean("color", ["K"], "🎨 Use color? (default: true)"),
  Declared.flagString(
    "madlib-json",
    ["madlib", "M"],
    "😈 Where is the madlib.json file? (default: ./madlib.json)",
  ),
  Declared.flagString("input", ["i"], "🥺 Set the input for the clowncar. Required."),
  Declared.flagString(
    "output",
    ["o"],
    "✨ Set the output for the clowncar. Inferred from `--input` if not provided.",
  ),
]
renderHelpDeets = (bool, useColor, flags) => {
  fn = (useColor ? EPrint.printLegendWithColor : EPrint.printLegend)
  return CLOWNCAR
    ++ "\n"
    ++ "Tooling to autogenerate PartyBus logging files, from a simple format:\n"
    ++ (
      bool
        ? `
  // comments are allowed, but only single line
  // this is the base tag value, equivalent to PartyBus.tag("bicycle")
  ${Term.text.bold(IO.red("bicycle"))}
  - ${
          IO.yellow("body")
        } // this is an implicit nested tag (so: PartyBus.tagWithScope("bicycle", ["body"]))
  - ${IO.yellow("body")}:${
          Term.text.cyan("fork")
        } // this is a nested implicit tag (so: PartyBus.tagWithScope("bicycle", ["body", "fork"]) and this becomes bodyFork)
  - ${Term.text.bold("config")} = ${
          IO.yellow("xyz")
        } // config = PartyBus.tagWithScope("bicycle", ["xyz"])
  - ${Term.text.bold("ref")} = ${IO.yellow("config")}:${
          Term.text.cyan("seat")
        } // ref = PartyBus.tagWithScope("bicycle", ["config", "seat"])
  - ${IO.yellow("handlebar")}
  - ${IO.yellow("handlebar")}:${Term.text.cyan("brake")}
  - ${IO.yellow("seat")}
  - ${IO.yellow("wheel")}
  - ${IO.yellow("wheel")}:${Term.text.cyan("spoke")}
  - ${IO.yellow("wheel")}:${Term.text.cyan("tire")}
  - ${IO.yellow("wheel")}:${Term.text.cyan("shifter")}
  - ${IO.yellow("wheel")}:${Term.text.cyan("brake")}
  - ${IO.yellow("wheel")}:${Term.text.cyan("brake")}:${Term.text.magenta("front")}
  - ${IO.yellow("wheel")}:${Term.text.cyan("brake")}:${Term.text.magenta("rear")}`
          ++ "\n\n"
        : ""
    )
    ++ fn(flags)
}
export renderHelp = renderHelpDeets(false)
export renderHelpWithDetail = renderHelpDeets(true)
processFlagState :: ClownState
  -> (ClownState -> Flag -> #[Boolean, ClownState])
  -> List Flag
  -> ClownState
processFlagState = (state, process, flags) => {
  walker = (done, aggState, toProcess) => if (done) {
    aggState
  } else {
    where(toProcess) {
      [] =>
        aggState

      [a, ...z] =>
        where(process(aggState, a)) {
          #[stop, upState] =>
            walker(stop, upState, z)
        }
    }
  }
  return walker(false, state, flags)
}
parseArgs = pipe(
  EFlags.parseFlags,
  Ensign.validate(FLAGS),
  Either.mapLeft(EPrint.printIssues),
)
captureTheFlag :: ClownState -> Flag -> #[Boolean, ClownState]
export captureTheFlag = (state, flag) => where(flag) {
  EFlags.Flag(k, v) =>
    if (k == "madlib-json") {
      #[true, { ...state, madlibJsonPath: v }]
    } else if (k == "input") {
      #[false, { ...state, input: Just(v) }]
    } else if (k == "output") {
      #[false, { ...state, output: Just(v) }]
    } else {
      #[false, state]
    }

  EFlags.FlagToggle(k, v) =>
    if (k == "help") {
      #[true, { ...state, showHelp: true }]
    } else if (k == "color") {
      #[false, { ...state, useColor: v }]
    } else {
      #[false, state]
    }

  EFlags.InvalidFlag =>
    #[true, { ...state, failure: Just("Passed invalid flags") }]
}
writeOut = (jsonPath, src, outPath) => pipe(
  MadlibJson.readAndParse,
  chain(
    (json) => pipe(
      ClownCar.applySpiritGumWithRules(json),
      outPath,
    )(src),
  ),
)(jsonPath)
export fillfull = Wish.fulfill(
  (bad) => {
    IO.putLine(bad)
    IO.put(renderHelp(true, FLAGS))
  },
  (good) => {
    IO.put(good)
  },
)
export consumeFlags = pipe(
  List.drop(1),
  parseArgs,
  map(processFlagState(State.INITIAL_STATE, captureTheFlag)),
)
export applyClownCar = where {
  Right({ input, madlibJsonPath, output }) =>
    where(#[input, output]) {
      #[Just(src), Just(out)] =>
        writeOut(madlibJsonPath, src, _File.write(out))

      #[Just(src), _] =>
        writeOut(madlibJsonPath, src, _File.writeDynamicName(src))

      _ =>
        Wish.bad("--input is required")
    }

  Left(why) =>
    Wish.bad(why)
}
export processArgs = pipe(
  consumeFlags,
  applyClownCar,
)
