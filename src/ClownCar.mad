import type { Maybe } from "Maybe"

import type { MadlibDotJson } from "mad-at-json"

import type { ClownState } from "@/State"

import Fn from "Function"
import List from "List"
import { Just, Nothing } from "Maybe"
import String from "String"
import Wish from "Wish"

import Version from "mad-at-json/Version"
import Line from "spirit-gum/Line"
import Rule from "spirit-gum/Rule"
import LineTransformer from "spirit-gum/Rule/TransformerLine"
import Template from "spirit-gum/Template"
import VFile from "spirit-gum/VFile"

import _List from "@/List"
import Log from "@/Log"
import { INITIAL_STATE } from "@/State"
import _String from "@/String"



// alias KeyScope = { base :: String, indented :: Boolean, key :: String, scope :: List String }


export grabAssignment = pipe(
  Fn.ifElse(
    String.match("="),
    pipe(
      Log.env.coreLogic("checking line with assignment"),
      String.split("="),
      map(String.trim),
      where {
        [key, v] =>
          String.isEmpty(key) ? #[Nothing, ""] : #[Just(key), v]

        _ =>
          #[Nothing, ""]
      },
    ),
    (v) => #[Nothing, v],
  ),
  where {
    #[k, v] =>
      #[
        k,
        pipe(
          String.split(":"),
          map(String.trim),
        )(v),
      ]
  },
)
export showParts = pipe(
  map(show),
  String.join(", "),
)
lineTag :: (Show a, Eq a) => Boolean -> String -> String -> String -> List a -> #[String, String]
export lineTag = (isChild, key, base, head, rest) => {
  _h = show(head)
  return #[
    key,
    if (List.isEmpty(rest)) {
      if (isChild) {
        `Party.tagWithScope(${show(base)}, [${_h}])`
      } else {
        `Party.tag(${_h})`
      }
    } else {
      `Party.tagWithScope(${_h}, [${showParts(rest)}])`
    },
  ]
}
applyWithBase :: Boolean -> String -> #[Maybe String, List String] -> #[String, String]
export applyWithBase = (isChild, base, vv) => where(vv) {
  #[Just(key), parts] =>
    where(#[List.first(parts), _List.chop(1, parts)]) {
      #[Just(head), rest] =>
        lineTag(isChild, key, base, head, rest)

      _ =>
        #["", ""]
    }

  #[Nothing, parts] =>
    if (String.isEmpty(base)) {
      where(#[List.first(parts), _List.chop(1, parts)]) {
        #[Just(head), rest] =>
          pipe(
            _String.camelCaseList,
            lineTag(isChild, $, base, head, rest),
          )(parts)

        _ =>
          #["", ""]
      }
    } else {
      #[_String.camelCaseList(parts), `Party.tagWithScope(${show(base)}, [${showParts(parts)}])`]
    }
}
processClownLine :: String -> String -> String -> ClownState -> #[ClownState, String]
processClownLine = (activeKey, active, line2, state) => {
  activeSet = !String.isEmpty(active)
  indented = _String.isIndented(line2)
  line3 = _String.stripIndentation(line2)
  parts = pipe(
    String.split("="),
    map(
      pipe(
        String.trim,
        String.split(":"),
      ),
    ),
  )(line3)
  hasAssignment = _String.checkAssignment(line3)

  assigned = grabAssignment(line3)
  bases = pipe(
    applyWithBase(indented, active),
  )(assigned)

  Log.env.core("processing non-empty line", line2)
  return if (hasAssignment) {
    if (activeSet) do {
      converted = where(parts) {
        [[key]] =>
          key

        _ =>
          ""
      }
      _active = #[activeKey, !indented ? converted : active]


      return #[
        {
          ...state,
          // scopes: [...state.scopes, converted],
          active: _active,
          bases: [...state.bases, bases],
        },
        line3,
      ]
    } else do {
      return pipe(
        String.split("="),
        map(String.trim),
        where {
          [a, b] =>
            #[a, b]

          _ =>
            #["", ""]
        },
        Log.env.coreRender("the new new"),
        (_active) => #[{ ...state, active: _active }, line3],
      )(line3)
    }
  } else do {
    converted = where(parts) {
      [x] =>
        _String.camelCaseList(x)

      _ =>
        ""
    }
    _active = #[activeKey, !indented ? converted : active]

    return #[{ ...state, active: _active, bases: [...state.bases, bases] }, line3]
  }
}
aggregateState :: ClownState -> Integer -> String -> #[ClownState, String]
export aggregateState = (state, _, line) => if (String.isEmpty(String.trim(line))) {
  #[{ ...state, active: #["", ""] }, line]
} else do {
  line2 = pipe(
    _String.stripComments,
    String.trim,
  )(line)
  return if (String.isEmpty(line2)) {
    #[state, ""]
  } else {
    where(state.active) {
      #[activeKey, active] =>
        processClownLine(activeKey, active, line2, state)
    }
  }
}
convertClownCarByLine = Rule.lineRule(
  false,
  "clown-car/meta/line",
  [],
  [LineTransformer.ofLineRaw(aggregateState)],
)
INDENT = "  "
stateToLines :: MadlibDotJson -> String -> String -> List String -> ClownState -> String
export stateToLines = (json, src, _, _, state) => {
  vals = pipe(
    map((#[k, v]) => mappend(INDENT, k ++ `: ${v},`)),
  )(state.bases)
  envVals = pipe(
    map((#[k, v]) => mappend(INDENT, k ++ `: Party.env(tags.${k}),`)),
  )(state.bases)
  tapVals = pipe(
    map((#[k, v]) => mappend(INDENT, k ++ `: Party.tap(env.${k}),`)),
  )(state.bases)
  return `/* ★★★ ${json.name}@${Version.showVersion(json.version)} ★★★
 * THIS FILE AUTOMATICALLY GENERATED FROM SOURCE: ${src}
 */

import Party from "PartyBus"



export tags = {${"\n" ++ String.unlines(vals)}
}
export env = {${"\n" ++ String.unlines(envVals)}
}
export tapped = {${"\n" ++ String.unlines(tapVals)}
}`
    ++ "\n"
}
applySpiritGumWithRules :: MadlibDotJson -> String -> Wish String String
export applySpiritGumWithRules = (json, src) => pipe(
  VFile.fromPath(src, [convertClownCarByLine]),
  Wish.mapRej(Fn.always("Unable to convert rules into spirit-gum vfile")),
  map(Template.renderWithConverter(map(Line.render), stateToLines(json, src))),
  Wish.mapRej(Fn.always("Unable to render")),
)(INITIAL_STATE)
