import IO from "IO"
import { Just, Nothing } from "Maybe"

import { Action } from "utter"
import Interpreter from "utter/Interpreter"
import Machine from "utter/Machine"
import State from "utter/State"
import Transition from "utter/Transition"

import { EVENTS, INITIAL_STATE, STATES, permaloop } from "@/State"
import GUARDS from "@/State/Guards"
import REDUCERS from "@/State/Reducers"



announceWith = (k) => Action(
  (e, mPay, mCtx) => {
    IO.pTrace((k ?? "") ++ "event: (" ++ e ++ ")", mPay)
  },
)
announce = announceWith(Nothing)
ACTIONS = [announce]
clowncarMachine = Machine.create(
  "clown-car",
  [
    State.create(
      STATES.initial,
      [
        Transition.create(
          "invokeProgram",
          STATES.configuration,
          [announceWith(Just("🛸 invokeProgram")), REDUCERS.parseArgs],
        ),
      ],
    ),
    State.create(
      STATES.configuration,
      [
        // read flags
        Transition.createImmediate(
          STATES.configuration,
          [announceWith(Just("🛸 auto configuration"))],
        ),
        Transition.create(EVENTS.convertInput, STATES.success, []),
        Transition.create(EVENTS.failedToConvert, STATES.failure, ACTIONS),
      ],
    ),
    State.createFinal(STATES.failure),
    State.createFinal(STATES.success),
  ],
)
export clowncarService = Interpreter.create(Just(INITIAL_STATE), clowncarMachine)
export clowncarServer = permaloop(clowncarService)
