import { Left, Right } from "Either"
import IO from "IO"
import { Just } from "Maybe"
import Wish from "Wish"

import { Reducer } from "utter"

import Cli from "@/Cli"
import { EventProcessing } from "@/State"
import { EventSetArgs, mergeStates } from "@/State"



export processState = Reducer((ev, pay, mCtx) => mCtx)
export parseArgs = Reducer(
  (ev, pay, mCtx) => where(#[pay, mCtx]) {
    #[EventSetArgs(args), Just(ctx)] =>
      where(Cli.consumeFlags(args)) {
        Right(processedCtx) =>
          IO.pTrace(
            "reducer.parseArgs",
            Just({ ...mergeStates(ctx, processedCtx), configured: true }),
          )

        Left(why) =>
          Just({ ...ctx, failure: Just(why), configured: true })
      }

    _ =>
      mCtx
  },
)
export processConfiguration = Reducer(
  (ev, pay, mCtx) => where(#[pay, mCtx]) {
    #[_, Just(ctx)] =>
      do {
        processMe = pipe(
          Right,
          Cli.applyClownCar,
          IO.pTrace("@@@"),
        )(ctx)

        return Just({ ...ctx, results: processMe, processed: true })
      }

    _ =>
      mCtx
  },
)
