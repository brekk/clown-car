import { Just, isJust } from "Maybe"

import Guard from "utter/Guard"



export hasConfiguration = Guard.create(
  (_, _, mCtx) => where(mCtx) {
    Just({ configured }) =>
      configured

    _ =>
      false
  },
)
export noConfiguration = Guard.invert(hasConfiguration)
export jsonSet = Guard.create(
  (_, _, mCtx) => where(mCtx) {
    Just({ madlibJson }) =>
      isJust(madlibJson)

    _ =>
      false
  },
)
export noJsonSet = Guard.invert(jsonSet)
export inputProcessed = Guard.create(
  (_, _, mCtx) => where(mCtx) {
    Just({ madlibJson }) =>
      isJust(madlibJson)

    _ =>
      false
  },
)
export inputUnprocessed = Guard.invert(inputProcessed)
