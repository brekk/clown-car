import IO from "IO"
import { Just, isJust } from "Maybe"

import Guard from "utter/Guard"



export isConfigured = Guard.create(
  (_, _, mCtx) => where(mCtx) {
    Just({ configured }) =>
      configured

    _ =>
      false
  },
)
export notConfigured = Guard.invert(isConfigured)
export inputProcessed = Guard.create(
  (ev, _, mCtx) => where(mCtx) {
    Just({ processed }) =>
      processed

    _ =>
      false
  },
)
export inputUnprocessed = Guard.invert(inputProcessed)
export hasFailure = Guard.create(
  (ev, _, mCtx) => where(mCtx) {
    Just({ failure }) =>
      isJust(failure)

    _ =>
      false
  },
)
export noFailure = Guard.invert(hasFailure)
