import IO from "IO"
import { Just, isJust } from "Maybe"

import Guard from "utter/Guard"



export _hasConfiguration = Guard.create(
  (_, _, mCtx) => where(mCtx) {
    Just({ configured }) =>
      configured

    _ =>
      false
  },
)
export _noConfiguration = Guard.invert(_hasConfiguration)
export inputProcessed = Guard.create(
  (ev, _, mCtx) => IO.pTrace(
    "checking: " ++ ev,
    where(mCtx) {
      Just({ processed }) =>
        processed

      _ =>
        false
    },
  ),
)
export inputUnprocessed = Guard.invert(inputProcessed)
