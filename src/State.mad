import type { Maybe } from "Maybe"
import type { Wish } from "Wish"

import type { Controller } from "utter/Types"

import IO from "IO"
import List from "List"
import { Just, Nothing, isJust } from "Maybe"
import String from "String"
import Wish from "Wish"

import Interpreter from "utter/Interpreter"
import State from "utter/State"
import { Controller, Machine } from "utter/Types"



export EVENTS = {
  initialize: "initialize",
  processArgs: "processArgs",
  readJson: "readMadlibJson",
  convertedInput: "convertedInput",
  failedToConvert: "failedToConvert",
}
export STATES = {
  initial: "initial",
  configuration: "configuration",
  failure: "failure",
  success: "success",
}
export alias ClownState = {
  active :: String,
  bases :: List #[String, String],
  configured :: Boolean,
  failure :: Maybe String,
  input :: Maybe String,
  madlibJsonPath :: String,
  output :: Maybe String,
  processed :: Boolean,
  showHelp :: Boolean,
  useColor :: Boolean,
}
INITIAL_STATE :: ClownState
export INITIAL_STATE = {
  failure: Nothing,
  active: "",
  bases: [],
  input: Nothing,
  madlibJsonPath: "./madlib.json",
  output: Nothing,
  showHelp: false,
  useColor: true,
  configured: false,
  processed: false,
}
stringRef = (def, a, b) => String.isEmpty(b) ? b : String.isEmpty(a) ? a : def
maybeRef = (ax, bx) => isJust(bx) ? bx : isJust(ax) ? ax : Nothing
mergeStates :: ClownState -> ClownState -> ClownState
export mergeStates = (a, b) => (
  {
    failure: maybeRef(a.failure, b.failure),
    active: stringRef("", a.active, b.active),
    bases: List.concat(a.bases, b.bases),
    input: maybeRef(a.input, b.input),
    madlibJsonPath: stringRef("./madlib.json", a.madlibJsonPath, b.madlibJsonPath),
    // madlibJson: maybeRef(a.madlibJson, b.madlibJson),
    output: maybeRef(a.output, b.output),
    showHelp: b.showHelp || a.showHelp,
    useColor: b.useColor || a.useColor,
    configured: b.configured || a.configured,
    processed: b.processed || a.processed,
  }
)
export type ClownCarPayload
  = EventSetArgs(List String)
  | EventSetMadlibJson(String)
  | EventProcessing
  | EventFailure
  | EventSuccess
export alias ClownCarControl = Controller ClownCarPayload ClownState
export alias OutsideInfluence = ClownCarControl -> ClownCarControl
export alias HiddenController = {
  get :: {} -> ClownCarControl,
  send :: OutsideInfluence -> ClownCarControl,
}
stateName = pipe(
  Interpreter.machine,
)
permaloop :: ClownCarControl -> HiddenController
export permaloop = (ctrl) => {
  iter = 0
  command = ctrl
  send :: OutsideInfluence -> ClownCarControl
  send = (run) => {
    iter := iter + 1
    command := pipe(
      run,
    )(command)
    return command
  }
  hidden :: HiddenController
  hidden = { send, get: () => command }
  return hidden
}
