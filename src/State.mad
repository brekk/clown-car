import type { Maybe } from "Maybe"

import type { Controller } from "utter/Types"

import List from "List"
import { Just, Nothing, isJust } from "Maybe"
import String from "String"

import Interpreter from "utter/Interpreter"
import State from "utter/State"
import { Controller } from "utter/Types"



export EVENTS = { initialize: "initialize", readFlags: "readFlags" }
export STATES = {
  initial: "initial",
  configuration: "configuration",
  failure: "failure",
  success: "success",
}
export alias ClownState = {
  active :: String,
  bases :: List #[String, String],
  configured :: Boolean,
  failure :: Maybe String,
  input :: Maybe String,
  madlibJson :: String,
  output :: Maybe String,
  showHelp :: Boolean,
  useColor :: Boolean,
}
INITIAL_STATE :: ClownState
export INITIAL_STATE = {
  failure: Nothing,
  active: "",
  bases: [],
  input: Nothing,
  madlibJson: "./madlib.json",
  output: Nothing,
  showHelp: false,
  useColor: true,
  configured: false,
}
stringRef = (def, a, b) => String.isEmpty(b.madlibJson)
  ? b.madlibJson
  : String.isEmpty(a.madlibJson) ? a.madlibJson : def
maybeRef = (ax, bx) => isJust(bx) ? bx : isJust(ax) ? ax : Nothing
mergeStates :: ClownState -> ClownState -> ClownState
export mergeStates = (a, b) => (
  {
    failure: maybeRef(a.failure, b.failure),
    active: stringRef("", a, b),
    bases: List.concat(a.bases, b.bases),
    input: maybeRef(a.input, b.input),
    madlibJson: stringRef("./madlib.json", a, b),
    output: maybeRef(a.output, b.output),
    showHelp: b.showHelp || a.showHelp,
    useColor: b.useColor || a.useColor,
    configured: b.configured || a.configured,
  }
)
export type ClownCarPayload
  = EventSetArgs(List String)
  | EventInitialize
  | EventProcessing
  | EventFailure
  | EventSuccess
export alias ClownCarControl = Controller ClownCarPayload ClownState
export alias OutsideInfluence = ClownCarControl -> ClownCarControl
export alias HiddenController = {
  get :: {} -> ClownCarControl,
  send :: OutsideInfluence -> ClownCarControl,
}
permaloop :: ClownCarControl -> HiddenController
export permaloop = (ctrl) => {
  iter = 0
  command = ctrl
  send :: OutsideInfluence -> ClownCarControl
  send = (run) => {
    iter := iter + 1
    command := pipe(
      run,
      // Log.tapped.loop("update " ++ show(iter) ++ ": ", stateName),
    )(command)
    return command
  }
  hidden :: HiddenController
  hidden = { send, get: () => command }
  return hidden
}
