import IO from "IO"
import List from "List"

import Interpreter from "utter/Interpreter"

import Cli from "@/Cli"
import { EVENTS, EventProcessing, EventSetArgs } from "@/State"
import Machine from "@/State/Machine"



SIGNAL = {
  initialize: pipe(
    EventSetArgs,
    Interpreter.send(EVENTS.initialize),
  ),
  convertInput: Interpreter.send(EVENTS.convertInput, EventProcessing),
}
mainRaw = (args) => {
  pipe(
    Cli.processArgs,
    Cli.fillfull,
  )(args)
}
main = (args) => {
  pipe(
    SIGNAL.initialize,
    Machine.clowncarServer.send,
    SIGNAL.convertInput,
  )(args)
}
