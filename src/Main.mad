import Interpreter from "utter/Controller"

import Cli from "@/Cli"
import { EVENTS, EventProcessing, EventSetArgs } from "@/State"
import Machine from "@/State/Machine"



SIGNAL = {
  initialize: pipe(
    EventSetArgs,
    Interpreter.send(EVENTS.initialize),
  ),
  convertInput: Interpreter.send(EVENTS.convertInput, EventProcessing),
}
/*
mainRaw = (args) => {
  pipe(
    Cli.processArgs,
    Cli.fillfull,
  )(args)
}
*/
main = (args) => {
  pipe(
    SIGNAL.initialize,
    Machine.clowncarServer.send,
    Interpreter.context,
    map(.results),
    map(Cli.fillfull),
  )(args)
}
